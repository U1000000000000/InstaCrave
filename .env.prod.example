# Production Environment Variables
# Copy this file to .env.prod and fill in real values

# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Redis
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION

# JWT
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG_SECRET_KEY
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# Argon2 Password Hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@instacrave.com

# CORS
FRONTEND_URL=https://your-production-domain.com

# Cache Version
APP_CACHE_VERSION=v1
