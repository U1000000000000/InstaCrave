{
  "rewrites": [
    {
      "source": "/socket.io/:path*",
      "destination": "https://instacrave.zeabur.app/socket.io/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://instacrave.zeabur.app/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://instacrave.zeabur.app/api/:path*"
    },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/socket.io/:path*",
      "headers": [
        {
          "key": "Connection",
          "value": "Upgrade"
        },
        {
          "key": "Upgrade",
          "value": "websocket"
        }
      ]
    }
  ]
}
