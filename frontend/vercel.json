{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://rendersal.onrender.com/instacrave/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://rendersal.onrender.com/instacraveapi/:path*"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}
