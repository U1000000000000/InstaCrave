# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/instacrave

# Redis Configuration (for rate limiting and caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_TLS=false
# Change to true in production for TLS/SSL connections

# Cache Configuration
APP_CACHE_VERSION=v1
# Bump this version (v2, v3, etc.) to instantly invalidate all caches on deployment

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-min-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-key-min-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# Argon2 Password Hashing (Production-grade security)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ImageKit Configuration (for image/video uploads)
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# Server Configuration
PORT=3000
NODE_ENV=development
# Set to 'production' for production deployments

# CORS / Client URLs
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_LOCAL=http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=3600000
# 1 hour in milliseconds
RATE_LIMIT_MAX_REQUESTS=5000
# Maximum requests per window for authenticated users
